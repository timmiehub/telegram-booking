{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": false,
    "es2022": true,
    "node": true
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "eqeqeq": "warn",
    "no-var": "error"
  },
  "ignorePatterns": ["node_modules", "logs"]
}