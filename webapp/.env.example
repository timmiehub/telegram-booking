# Скопируйте в webapp/.env и заполните
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Google AI Studio → Get API key
VITE_GEMINI_API_KEY=
# Short name Direct Link Mini App из BotFather (/newapp).
# Тогда ссылка будет t.me/booking_inapp_bot/ИМЯ?startapp=slug и откроет приложение сразу.
# VITE_TG_APP_SHORT_NAME=book

# Публичная ссылка на подписку Tribute «Booking Pro» (без секретов)
# VITE_TRIBUTE_PRO_URL=https://t.me/tribute/...
# Текст цены на кнопках (синхрон с тарифом в Tribute)
# VITE_PRO_PRICE_LABEL=пробный бесплатно · далее 499 ₽/мес
